APP_NAME="Steklograd"
APP_ENV=local
APP_DEBUG=true
APP_PORT=80
APP_KEY=
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=file

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=steklograd
DB_USERNAME=steklograd
DB_PASSWORD=password

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

ADMIN_EMAIL=admin@example.com

MAIL_MAILER=smtp
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-password
CONTACT_MAILS=admin@example.com

MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME="Steklograd"

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
